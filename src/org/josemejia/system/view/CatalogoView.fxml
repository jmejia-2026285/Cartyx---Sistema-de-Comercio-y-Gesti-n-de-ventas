<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="14" stylesheets="@../resources/styles/CatalogoStyles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.josemejia.system.controller.CatalogoController">
   <padding>
      <Insets bottom="18" left="18" right="18" top="18" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <children>
            <Label maxWidth="Infinity" styleClass="titulo-vista" text="Catálogo" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVerCarrito" onAction="#handleVerCarrito" styleClass="boton-primario" text="Ver Carrito" />
            <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="boton-secundario" text="Volver al Menú" />
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" styleClass="scroll-catalogo" VBox.vgrow="ALWAYS">
         <content>
            <FlowPane fx:id="panelTarjetas" hgap="16" vgap="16" styleClass="panel-tarjetas" />
         </content>
      </ScrollPane>
   </children>
</VBox>
