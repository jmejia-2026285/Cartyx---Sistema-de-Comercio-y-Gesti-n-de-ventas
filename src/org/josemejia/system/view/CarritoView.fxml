<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="14" stylesheets="@../resources/styles/CarritoStyles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.josemejia.system.controller.CarritoController">
   <padding>
      <Insets bottom="18" left="18" right="18" top="18" />
   </padding>
   <children>
      <Label styleClass="titulo-vista" text="Mi Carrito" />

      <TableView fx:id="tablaCarrito" prefHeight="280.0" styleClass="tabla">
         <columns>
            <TableColumn fx:id="colProducto" prefWidth="220.0" text="Producto" />
            <TableColumn fx:id="colPrecioUnitario" prefWidth="110.0" text="Precio" />
            <TableColumn fx:id="colCantidad" prefWidth="150.0" text="Cantidad" />
            <TableColumn fx:id="colSubtotal" prefWidth="110.0" text="Subtotal" />
         </columns>
      </TableView>

      <Label fx:id="lblTotal" styleClass="texto-total" text="Total: Q0.00" />

      <HBox spacing="10">
         <children>
            <Button fx:id="btnConfirmar" onAction="#handleConfirmarCompra" styleClass="boton-primario" text="Confirmar Compra" />
            <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="boton-secundario" text="Volver al Catálogo" />
         </children>
      </HBox>
   </children>
</VBox>
